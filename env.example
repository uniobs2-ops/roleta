# Copie estes nomes para as variáveis de ambiente do seu servidor (Render, Railway, etc.)

# Token do bot (BotFather)
BOT_TOKEN=123456:ABC-seu-token

# Seu ID numérico do Telegram (admin). Vários: 111,222
ADMIN_IDS=123456789

# URL do site da roleta (GitHub Pages)
WEBAPP_URL=https://seuusuario.github.io/roleta/

# URL pública deste backend (sem barra no final)
PUBLIC_URL=https://seu-backend.onrender.com

# Qualquer texto longo e aleatório (protege o webhook)
WEBHOOK_SECRET=troque-por-algo-longo-e-aleatorio

# Domínio do site, para liberar o CORS (sem caminho). Ex: https://seuusuario.github.io
ALLOWED_ORIGINS=https://seuusuario.github.io

# Onde guardar o banco. Em hospedagem com disco persistente, aponte para ele. Ex: /data/roleta.db
DB_PATH=roleta.db

# Fuso usado para o "dia" do token diário do VIP
TIMEZONE=America/Sao_Paulo
